# typed: strict
# frozen_string_literal: true

# SimpleCov compatibility bundle used by the `simplecov-compat` CI job:
#   BUNDLE_GEMFILE=gemfiles/simplecov_1.1.gemfile bundle install
#   BUNDLE_GEMFILE=gemfiles/simplecov_1.1.gemfile bundle exec rspec
source 'https://rubygems.org'

gemspec path: '..'

gem 'simplecov', '~> 1.1.0'
