# typed: strict
# frozen_string_literal: true

# SimpleCov compatibility bundle used by the `simplecov-compat` CI job:
#   BUNDLE_GEMFILE=gemfiles/simplecov_0.22.gemfile bundle install
#   BUNDLE_GEMFILE=gemfiles/simplecov_0.22.gemfile bundle exec rspec
source 'https://rubygems.org'

gemspec path: '..'

gem 'simplecov', '~> 0.22.0'
