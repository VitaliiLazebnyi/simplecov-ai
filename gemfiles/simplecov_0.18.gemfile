# typed: strict
# frozen_string_literal: true

# SimpleCov compatibility bundle used by the `simplecov-compat` CI job:
#   BUNDLE_GEMFILE=gemfiles/simplecov_0.18.gemfile bundle install
#   BUNDLE_GEMFILE=gemfiles/simplecov_0.18.gemfile bundle exec rspec
source 'https://rubygems.org'

gemspec path: '..'
eval_gemfile 'test.gemfile'

# The SimpleCov release line this bundle runs the suite against.
gem 'simplecov', '~> 0.18.0'
